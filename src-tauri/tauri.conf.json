{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Context Hub",
  "version": "1.2.0",
  "identifier": "com.contexthub.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Context Hub",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDNTIxRDJEQTA4OUMzMzcKUldRM3c0bWdMUjFTdkh6VzR5RWF1UzkxcFVQeFdrM1FPRXZWQ2crU2VTdTZJMTlMUWhuTnJWY2gK",
      "endpoints": [
        "https://github.com/SC136/context-hub/releases/latest/download/latest.json"
      ]
    }
  }
}
